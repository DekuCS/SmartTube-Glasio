<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="io.github.ivanosh.stmaterial.MaterialApplication"
        android:allowBackup="false"
        tools:replace="android:name,android:allowBackup">

        <!-- MATERIAL: no external zip import -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.common.misc.BackupReceiverActivity"
            tools:node="remove" />

        <activity
            android:name="io.github.ivanosh.stmaterial.browse.MaterialBrowseActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.browse.MaterialSectionsEditorActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />
    </application>
</manifest>
