<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- MATERIAL: the in-app updater hands a verified APK to the system installer, which asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MATERIAL: permissions of features this flavor does not have: voice search, the overlay, uninstalling apps, DIAL, TV channels. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" tools:node="remove" />

    <application
        android:name="io.github.ivanosh.stmaterial.MaterialApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/material_data_extraction_rules"
        tools:replace="android:name,android:allowBackup">

        <!-- MATERIAL: no external zip import -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.common.misc.BackupReceiverActivity"
            tools:node="remove" />

        <!-- MATERIAL: casting is not included, and this receiver would start the app at every boot and clock change. -->
        <receiver android:name="com.liskovsoft.smartyoutubetv2.common.misc.RemoteControlReceiver"
            tools:node="remove" />

        <!-- MATERIAL: no home screen channels, no search provider: nothing exported from leanbackassistant. -->
        <receiver android:name="com.liskovsoft.leanbackassistant.channels.UpdateChannelsReceiver"
            tools:node="remove" />
        <provider android:name="com.liskovsoft.leanbackassistant.search.VideoContentProvider"
            android:authorities="org.smarttube"
            tools:node="remove" />
        <activity android:name="com.liskovsoft.leanbackassistant.search.SearchableActivity"
            tools:node="remove" />

        <activity
            android:name="io.github.ivanosh.stmaterial.browse.MaterialBrowseActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.browse.MaterialSectionsEditorActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <!-- The attributes of the upstream PlaybackActivity: PIP, the player theme and showing over the lock screen depend on them. -->
        <activity
            android:name="io.github.ivanosh.stmaterial.player.MaterialPlaybackActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboard|keyboardHidden|navigation"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:showWhenLocked="true"
            android:theme="@style/App.Theme.Leanback.Player" />

        <!-- Translucent like the dialogs: the player under it is paused, not stopped, and plays on. -->
        <activity
            android:name="io.github.ivanosh.stmaterial.player.MaterialButtonsEditorActivity"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified"
            android:theme="@style/Material.Theme.Dialog" />

        <!-- noHistory and singleInstance as in the upstream dialog; the translucent theme keeps the player visible behind. -->
        <activity
            android:name="io.github.ivanosh.stmaterial.dialog.MaterialDialogActivity"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified"
            android:theme="@style/Material.Theme.Dialog" />

        <!-- Like the upstream ones: one instance each, so that a presenter can start the view that is already open. -->
        <activity
            android:name="io.github.ivanosh.stmaterial.search.MaterialSearchActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.channel.MaterialChannelActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.channel.MaterialUploadsActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.signin.MaterialSignInActivity"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />

        <activity
            android:name="io.github.ivanosh.stmaterial.settings.MaterialSettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="unspecified" />
    </application>
</manifest>
